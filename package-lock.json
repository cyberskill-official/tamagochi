{
  "name": "tamagochi",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tamagochi",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "apps/cocos": {
      "name": "apps-cocos-package",
      "version": "0.1.0"
    },
    "apps/petos-console": {
      "name": "apps-petos-console-package",
      "version": "0.1.0"
    },
    "apps/realtime": {
      "name": "apps-realtime-package",
      "version": "0.1.0"
    },
    "node_modules/apps-cocos-package": {
      "resolved": "apps/cocos",
      "link": true
    },
    "node_modules/apps-petos-console-package": {
      "resolved": "apps/petos-console",
      "link": true
    },
    "node_modules/apps-realtime-package": {
      "resolved": "apps/realtime",
      "link": true
    }
  }
}
